# Django
SECRET_KEY=change-me-use-a-long-random-string-at-least-50-chars
DEBUG=False

# Hosts — set to the domain or IP your browser uses to reach the app
ALLOWED_HOSTS=localhost
CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
CSRF_COOKIE_SECURE=False

# Database — DB_HOST must match the compose service name ("db")
DB_HOST=db
DB_USER=greenhouse
DB_PASSWORD=change-me-db-password
DB_NAME=greenhouse

# Admin account created on first startup
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change-me-superuser-password

# Frontend — must be the URL the browser can reach (not a docker-internal hostname)
API_URL=http://localhost:8000/api/v1
